# Server Configuration
PORT=5000
NODE_ENV=production

# Client Origin for CORS
CLIENT_URL=https://tu-dominio-final.com

# Security Secrets (JWT)
JWT_ACCESS_SECRET=generar_clave_segura_aqui_64_chars
JWT_REFRESH_SECRET=generar_clave_segura_aqui_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true

# Supabase Database & API Connection
SUPABASE_URL=https://xxxxxxxxx.supabase.co
SUPABASE_KEY=xxxxxxxxx
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
PRISMA_ENABLED=true

# AI Assistant Integration (Groq Primary)
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
